{
  "expo": {
    "name": "Vehicle Service Center",
    "slug": "vehicle-service-center",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e3a8a"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Vehicle Service to use your location for carrier requests."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vehicleservice.app"
    },
    "android": {
      "package": "com.vehicleservice.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro"
    },
    "newArchEnabled": false,
    "extra": {
      "apiBaseUrl": "https://vehical-care-react-native-project.onrender.com/api"
    }
  }
}
