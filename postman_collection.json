            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Body Wash\",\n  \"description\": \"Full exterior wash with premium foam and hand dry\",\n  \"price\": 799,\n  \"duration\": 60\n}"
            }
          }
        },
        {
          "name": "Update Service (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cleaning-services/:id",
              "host": ["{{baseUrl}}"],
              "path": ["cleaning-services", ":id"],
              "variable": [{ "key": "id", "value": "SERVICE_ID_HERE" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 899,\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Delete Service (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cleaning-services/:id",
              "host": ["{{baseUrl}}"],
              "path": ["cleaning-services", ":id"],
              "variable": [{ "key": "id", "value": "SERVICE_ID_HERE" }]
            }
          }
        }
      ]
    },
